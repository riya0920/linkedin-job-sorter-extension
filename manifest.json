{
  "manifest_version": 3,
  "name": "LinkedIn Job Sorter",
  "version": "6.5",
  "description": "Sorts LinkedIn job results newest-first, splits reposts and agencies into their own tabs, checks H-1B sponsorship (known-sponsor list + optional Gemini AI), scores fit, tracks seen/applied.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/search*"
      ],
      "js": [
        "sponsors.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
